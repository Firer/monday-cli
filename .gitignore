# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
coverage/
test-results/
.vitest-cache/

# Local secrets / config
.env
.env.local
.env.*.local
# npm credential config — npm flows sometimes write a .npmrc to cwd
# (e.g. on `npm publish` when no global config is present); we
# always want the credential reference in ~/.npmrc only, never the
# repo. Belt-and-braces: even an `${NPM_TOKEN}`-reference variant
# shouldn't land in git history.
.npmrc

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Local Claude state (per-developer)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Working files from collaborator reviews (codex/gemini/claude review outputs)
.review-*.md

# Per-session handover artifacts — preserved for the next agent run,
# not committed.
.session-handover/

# Throwaway probes (M20: scripts/probe-{bootstrap,time-tracking}.ts
# poke a real Monday workspace to pin wire shapes). Local only —
# never committed. The shared `_lib.ts` scaffold (R-candidate fired
# at v0.3-M21 second consumer) is the one tracked exception so probe
# scripts can `import` from it; per-probe scripts stay local.
#
# Pattern note: gitignore can't re-include a file under an excluded
# directory, so we list every per-file pattern individually rather
# than excluding the whole `scripts/` directory.
scripts/*
scripts/*/*
!scripts/probe/
!scripts/probe/_lib.ts
